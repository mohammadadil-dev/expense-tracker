    <string name="tour_step1_title">ವೆಚ್ಚ ದಾಖಲಿಸಿ</string>
    <string name="tour_step1_body">ಯಾವುದೇ ವೆಚ್ಚ ದಾಖಲಿಸಲು + ಬಟನ್ ಒತ್ತಿ. ಮೊತ್ತ ನಮೂದಿಸಿ, ವರ್ಗ ಆರಿಸಿ, ದಿನಾಂಕ ಆರಿಸಿ, ಉಳಿಸಿ.</string>
    <string name="tour_step2_title">ಮಾಸಿಕ ಅವಲೋಕನ</string>
    <string name="tour_step2_body">ವೆಚ್ಚ vs ಬಜೆಟ್ ಒಂದೇ ನೋಟದಲ್ಲಿ. ಹಿಂದಿನ ತಿಂಗಳುಗಳಿಗೆ ‹ › ಒತ್ತಿ.</string>
    <string name="tour_step3_title">ಆದಾಯ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ</string>
    <string name="tour_step3_body">ಈ ತಿಂಗಳು ಎಷ್ಟು ಗಳಿಸಿದ್ದೀರಿ ಎಂದು ನೋಡಲು ಆದಾಯ ಕಾರ್ಡ್ ಒತ್ತಿ.</string>
    <string name="tour_step4_title">ಸಾಲಗಳು &amp; ಋಣಗಳು</string>
    <string name="tour_step4_body">ನೀವು ಕೊಡಬೇಕಾದ ಅಥವಾ ಪಡೆಯಬೇಕಾದ ಮೊತ್ತ ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಸಾಲಗಳ ಟ್ಯಾಬ್ ಬಳಸಿ.</string>
    <string name="tour_step5_title">ಹೆಚ್ಚು ಅನ್ವೇಷಿಸಿ</string>
    <string name="tour_step5_body">ಲೆಡ್ಜರ್ ಅಂಗಡಿ ಸಾಲ ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ವರದಿ ರಫ್ತು ಮಾಡಬಹುದು.</string>
    <string name="tour_step6_title">📷 ರಸೀದಿಗಳು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ</string>
    <string name="tour_step6_body">ಯಾವುದೇ ಬಿಲ್ ಅಥವಾ ರಸೀದಿ ಮೇಲೆ ಕ್ಯಾಮೆರಾ ಇಡಿ. ಆ್ಯಪ್ ಮೊತ್ತ ಓದಿ ತಕ್ಷಣ ದಾಖಲಿಸುತ್ತದೆ — ಟೈಪ್ ಮಾಡಬೇಕಾಗಿಲ್ಲ.</string>
    <string name="tour_step7_title">🎤 ಧ್ವನಿ ಇನ್‌ಪುಟ್</string>
    <string name="tour_step7_body">"ಊಟಕ್ಕೆ 50 ಖರ್ಚು ಮಾಡಿದೆ" ಎಂದು ಹೇಳಿ, ದಾಖಲಾಗುತ್ತದೆ. ಹ್ಯಾಂಡ್ಸ್-ಫ್ರೀ ವೆಚ್ಚ ಟ್ರ್ಯಾಕಿಂಗ್.</string>
    <string name="tour_step8_title">👥 ಬಿಲ್‌ಗಳನ್ನು ಹಂಚಿ</string>
    <string name="tour_step8_body">ಗ್ರೂಪ್‌ಗಳನ್ನು ಮಾಡಿ, ಹಂಚಿಕೆ ವೆಚ್ಚ ಸೇರಿಸಿ, ಯಾರು ಎಷ್ಟು ಕೊಡಬೇಕು ಎಂದು ಆ್ಯಪ್ ಲೆಕ್ಕ ಹಾಕಲಿ. ಒಂದು WhatsApp ಸಂದೇಶದಲ್ಲಿ ತೀರಿಸಿ.</string>
    <string name="tour_step9_title">📒 ಖಾತೆ / ಲೆಡ್ಜರ್</string>
    <string name="tour_step9_body">ಯಾರು ನಿಮಗೆ ಕೊಡಬೇಕು, ನೀವು ಯಾರಿಗೆ ಕೊಡಬೇಕು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ಒಂದೇ ಒತ್ತಿನಲ್ಲಿ WhatsApp ರಿಮೈಂಡರ್ ಕಳುಹಿಸಿ.</string>
    <string name="tour_step10_title">🎯 ಗುರಿಗಳು &amp; ಸ್ಟ್ರೀಕ್</string>
    <string name="tour_step10_body">ಉಳಿತಾಯ ಗುರಿಗಳನ್ನು ಹೊಂದಿಸಿ ಮತ್ತು ಪ್ರಗತಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ದೈನಂದಿನ ದಾಖಲಿಸುವ ಅಭ್ಯಾಸ ಬೆಳೆಸಿಕೊಳ್ಳಿ!</string>

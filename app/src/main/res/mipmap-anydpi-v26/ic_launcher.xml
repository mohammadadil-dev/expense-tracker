<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <!-- Bitmap, not the old vector — the "BAQAYA" wordmark needs real font rendering, which
         vector drawables can't do (no <text> support, only path data). Generated at every
         density bucket (mipmap-mdpi through -xxxhdpi) from the same source composition. -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

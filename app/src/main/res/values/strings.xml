    <!-- Guided coachmark tour -->
    <string name="tour_step1_title">Log an Expense</string>
    <string name="tour_step1_body">Tap the + button to record any expense. Enter the amount, pick a category, choose a date, and save.</string>
    <string name="tour_step2_title">Your Monthly Overview</string>
    <string name="tour_step2_body">Spending vs. budget at a glance. Tap ‹ › to browse past months.</string>
    <string name="tour_step3_title">Track Your Income</string>
    <string name="tour_step3_body">Tap the Income card to log your salary or any earnings. See how much you\'ve earned this month at a glance.</string>
    <string name="tour_step4_title">Debts &amp; Loans</string>
    <string name="tour_step4_body">Use the Debts tab to track what you owe or are owed, with automatic payoff projections and EMI reminders.</string>
    <string name="tour_step5_title">Explore More</string>
    <string name="tour_step5_body">Ledger tracks shop credit. Settings lets you export reports, back up your data, and set daily reminders.</string>
    <string name="tour_step6_title">📷 Scan Receipts</string>
    <string name="tour_step6_body">Point your camera at any bill or receipt. The app reads the amount and logs the expense instantly — no typing needed.</string>
    <string name="tour_step7_title">🎤 Voice Input</string>
    <string name="tour_step7_body">Just say \"spent 50 on food\" and it\'s logged. Hands-free expense tracking for when you\'re on the go.</string>
    <string name="tour_step8_title">👥 Split Bills</string>
    <string name="tour_step8_body">Create groups, add shared expenses, and let the app calculate who owes what. Settle up with one WhatsApp message.</string>
    <string name="tour_step9_title">📒 Khata / Ledger</string>
    <string name="tour_step9_body">Track who owes you money and what you owe others. Send payment reminders directly on WhatsApp with one tap.</string>
    <string name="tour_step10_title">🎯 Goals &amp; Streaks</string>
    <string name="tour_step10_body">Set savings goals and track your progress. Build a daily logging habit and keep your streak going!</string>
    <string name="tour_next">Next</string>
    <string name="tour_done">Let\'s go!</string>
    <string name="tour_skip">Skip</string>


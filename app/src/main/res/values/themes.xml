<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ExpenseTracker" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Dark green window background matches splash/onboarding — hides any flash during
             Activity recreation (locale change). windowAnimationStyle = @null disables the
             enter/exit Activity animation so there is no visible transition frame at all. -->
        <item name="android:statusBarColor">@color/bg_dark_green</item>
        <item name="android:windowBackground">@color/bg_dark_green</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Matches the directory PdfExporter writes generated reports into
         (context.cacheDir/exports). -->
    <cache-path name="exports" path="exports/" />
    <!-- Matches the root of cacheDir where BackupManager writes the JSON backup file. -->
    <cache-path name="cache" path="." />
    <!-- Temp images captured by the camera for receipt scanning. -->
    <cache-path name="camera" path="camera/" />
</paths>

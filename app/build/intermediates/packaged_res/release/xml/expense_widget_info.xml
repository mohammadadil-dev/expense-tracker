<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen widget metadata for ExpenseWidget.
    minWidth/Height = roughly 2×1 cells on most launchers.
    updatePeriodMillis = 0 because we push updates from ExpenseApp and ExpenseRepository
    on every data change rather than relying on the system's minimum 30-min poll.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
